{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset of SeniorDeveloper-pl-Dominik-Sienkiewicz; consumers extend github>SeniorDeveloper-pl-Dominik-Sienkiewicz/Platform. It updates what the application owns: its Gradle and npm dependencies (pinned exactly), GitHub Actions and Docker images. The frame (the Platform catalog, the frontend canon, the Gradle wrapper and every Platform pin) is left to platform-bump (reusable platform-bump.yml); its rules, marked Frame:, are generated by scripts/renovate-preset.py.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "description": "Security fixes skip the cooling-off period and the Monday window.",
    "labels": ["security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "The application's own Gradle and npm versions are pinned exactly, as the frame is (ADR-0037).",
      "matchManagers": ["gradle", "npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Peer dependency and engines ranges stay ranges.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies", "engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "GitHub Actions in one group.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "addLabels": ["ci"]
    },
    {
      "description": "Frame: the Gradle version comes from Platform; platform-bump moves the wrapper.",
      "matchManagers": ["gradle-wrapper"],
      "enabled": false
    },
    {
      "description": "Frame: the libraries and BOMs of the Platform catalog and Platform's own artifacts (generated from gradle/catalog/libs.versions.toml by scripts/renovate-preset.py); platform-bump moves them.",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "com.google.errorprone:error_prone_core",
        "com.tngtech.archunit:archunit-junit5",
        "com.uber.nullaway:nullaway",
        "org.jspecify:jspecify",
        "org.junit:junit-bom",
        "org.postgresql:postgresql",
        "org.springframework.ai:spring-ai-bom",
        "org.springframework.boot:spring-boot-dependencies",
        "org.springframework.boot:spring-boot-starter-actuator",
        "org.springframework.boot:spring-boot-starter-webmvc",
        "org.springframework.boot:spring-boot-starter-webmvc-test",
        "org.springframework.modulith:spring-modulith-bom",
        "org.springframework.modulith:spring-modulith-starter-core",
        "pl.seniordeveloper:*"
      ],
      "enabled": false
    },
    {
      "description": "Frame: the Gradle plugins of the Platform catalog and Platform's convention plugins, by plugin id and by marker coordinate (generated by scripts/renovate-preset.py); platform-bump moves them.",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "com.diffplug.spotless",
        "com.diffplug.spotless:com.diffplug.spotless.gradle.plugin",
        "info.solidsoft.pitest",
        "info.solidsoft.pitest:info.solidsoft.pitest.gradle.plugin",
        "io.spring.dependency-management",
        "io.spring.dependency-management:io.spring.dependency-management.gradle.plugin",
        "net.ltgt.errorprone",
        "net.ltgt.errorprone:net.ltgt.errorprone.gradle.plugin",
        "org.cyclonedx.bom",
        "org.cyclonedx.bom:org.cyclonedx.bom.gradle.plugin",
        "org.gradle.test-retry",
        "org.gradle.test-retry:org.gradle.test-retry.gradle.plugin",
        "org.jooq.jooq-codegen-gradle",
        "org.jooq.jooq-codegen-gradle:org.jooq.jooq-codegen-gradle.gradle.plugin",
        "org.sonarqube",
        "org.sonarqube:org.sonarqube.gradle.plugin",
        "org.springframework.boot",
        "org.springframework.boot:org.springframework.boot.gradle.plugin",
        "seniordev.*"
      ],
      "enabled": false
    },
    {
      "description": "Frame: the frontend canon and Platform's npm packages (generated from frontend/packages/versions/versions.json by scripts/renovate-preset.py); platform-bump moves them.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@eslint/compat",
        "@eslint/js",
        "@playwright/test",
        "@tailwindcss/postcss",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@typescript/typescript6",
        "@vitejs/plugin-react",
        "@vitest/coverage-v8",
        "eslint",
        "eslint-config-next",
        "globals",
        "jsdom",
        "next",
        "openapi-typescript",
        "prettier",
        "prettier-plugin-tailwindcss",
        "react",
        "react-dom",
        "tailwindcss",
        "typescript",
        "typescript-native",
        "vite",
        "vitest",
        "@seniordeveloper-pl-dominik-sienkiewicz/*",
        "@dominiksienkiewicz/*"
      ],
      "enabled": false
    },
    {
      "description": "Frame: Platform's reusable workflows are called by an exact vX.Y.Z that platform-bump moves; Renovate neither updates nor SHA-pins them.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["SeniorDeveloper-pl-Dominik-Sienkiewicz/Platform", "DominikSienkiewicz/Platform"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Testcontainers image tags in PlatformImages.java (datasource docker); a no-op in repositories without that file.",
      "managerFilePatterns": ["/PlatformImages\\.java$/"],
      "matchStrings": ["\"(?<depName>[^\"]+?):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}

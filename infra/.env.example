# Skopiuj do .env i dostosuj. .env jest ignorowany przez git.
# Szablon współdzielony — nadpisz POSTGRES_DB/USER nazwą projektu w repo konsumenta.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

# Ollama (profil "ai" — uruchom: docker compose --profile ai up -d)
OLLAMA_PORT=11434

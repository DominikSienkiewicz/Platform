# .secrets.local — LOKALNE wartości do bootstrapu sekretów/zmiennych GitHub Actions.
# Skopiuj do .secrets.local (git-ignored) i wypełnij. NIE commituj wypełnionego pliku.
# Wczytywane przez scripts/setup-gh-deploy.sh (bezpieczny parser KEY=VALUE — plik NIE jest wykonywany).
#
# Kontrakt musi pasować do reusable deploy.yml@v1.

# --- Secrets ---
GPR_USER=dominiksienkiewicz          # GitHub user do GitHub Packages
GPR_KEY=                             # PAT (classic) read:packages — artefakty Platform (Maven)
NPM_GH_TOKEN=                        # PAT (classic) read:packages — pakiety npm @dominiksienkiewicz/*
SSH_HOST=1.2.3.4                     # host/IP boksa deploya (SSH_KNOWN_HOSTS = ssh-keyscan tego hosta)
SSH_USER=deploy                      # użytkownik SSH deploya
SSH_KEY_FILE=~/.ssh/app_deploy       # ścieżka do PRYWATNEGO klucza (trafia do sekretu SSH_KEY); --gen-key wygeneruje

# --- Variables ---
GHCR_OWNER=dominiksienkiewicz        # owner obrazów w GHCR
DEPLOY_PATH=/opt/app                 # katalog docelowy na boksie

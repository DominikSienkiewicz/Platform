FROM sapmachine:27-jre
WORKDIR /app
RUN groupadd --system spring && useradd --system --gid spring --uid 1001 spring
ARG JAR_FILE=build/libs/*.jar
COPY ${JAR_FILE} app.jar
USER spring
EXPOSE 8080
# Sterta względem limitu pamięci kontenera, a OOM kończy proces, więc restart policy podnosi świeży. Compose
# nadpisuje całą zmienną, nie pojedynczą flagę.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
# Liveness przez /dev/tcp basha: obraz nie ma curla ani wgeta. 404 sondy liveness (management.endpoint.health.probes
# wyłączone) cofa do /actuator/health; zdrowe jest tylko 200. Port: MANAGEMENT_SERVER_PORT, potem SERVER_PORT.
# Bramka deploy-remote.sh czeka na healthy tylko wtedy, gdy kontener ma healthcheck.
HEALTHCHECK --start-period=60s --interval=10s --timeout=3s --retries=6 \
  CMD ["bash", "-c", "status() { exec 3<>/dev/tcp/127.0.0.1/${MANAGEMENT_SERVER_PORT:-${SERVER_PORT:-8080}} && printf 'GET %s HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' $1 >&3 && read -r -t 2 _ code _ <&3 && echo ${code:0:3}; }; code=$(status /actuator/health/liveness 2>/dev/null); if [ x$code = x404 ]; then code=$(status /actuator/health 2>/dev/null); fi; [ x$code = x200 ]"]
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

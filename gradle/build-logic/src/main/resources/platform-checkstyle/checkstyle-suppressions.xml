<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <suppress checks="LineLength" files="package-info\.java"/>
    <!-- Klasy @SpringBootApplication i test-launchery mają tylko main() → Checkstyle widzi "utility
         class", ale prywatny konstruktor zepsułby Spring Boot. Wyłączamy regułę dla *Application. -->
    <suppress checks="HideUtilityClassConstructor" files=".*Application\.java"/>
    <suppress
            checks="FileLength"
            files=".*/modules/.*/infrastructure/web/.*(Command|Query)Controller\.java"/>

</suppressions>

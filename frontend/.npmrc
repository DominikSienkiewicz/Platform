# GitHub Packages dla scope @dominiksienkiewicz.
# UWAGA: scope MUSI być nazwą właściciela repo GitHub (lowercase). Zmień, jeśli inny owner.
@dominiksienkiewicz:registry=https://npm.pkg.github.com
# pnpm 11 rozwija tokeny wyłącznie z zaufanego ~/.npmrc; CI konfiguruje go przez actions/setup-node.
auto-install-peers=true
